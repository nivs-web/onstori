{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git stash*)",
      "Bash(git push *)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npx tsc*)",
      "Bash(git push)",
      "Bash(git merge*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(npm run deploy*)",
      "Bash(vercel env rm*)",
      "Bash(npx vercel env rm*)",
      "Bash(vercel rm*)",
      "Bash(npx vercel rm*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(npx supabase db reset*)",
      "Bash(supabase db execute*)",
      "Bash(npx supabase db execute*)",
      "Bash(supabase migration up*)",
      "Bash(npx supabase migration up*)",
      "Bash(supabase migration repair*)",
      "Bash(npx supabase migration repair*)",
      "Bash(psql*)",
      "Bash(git push origin +*)"
    ]
  },
  "env": {
    "ONSTORI_AI_DIR": "C:/Users/ariancepc/Desktop/cowork/fable51plandept/ai-company"
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/ariancepc/Desktop/cowork/onhome/onstori/.claude/hooks/statusline.ps1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-session-start.ps1"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-stop.ps1"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-precompact.ps1"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.ps1"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.ps1"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
