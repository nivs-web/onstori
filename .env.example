# 복사해서 .env.local 로 사용 (.env.local 은 git에 올라가지 않음)
# 값은 Supabase 대시보드 → Settings → API 에서 복사

NEXT_PUBLIC_SUPABASE_URL=https://wpsrfjqfbhmeriscdacu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# P2에서 사용
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# P4 카카오 로그인 (카카오 개발자 콘솔 → 앱 키 / 보안)
# Supabase 카카오 프로바이더 대신 OIDC 직결 — 자세한 이유는 lib/kakao.ts
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# P5에서 사용 (토스페이먼츠 — 통신판매업 신고 후)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 이미지 저장소 — Cloudflare R2 (docs/specs/storage-r2.md)
# 6개가 전부 있어야 R2를 쓰고, 하나라도 비면 Supabase Storage로 폴백한다(로컬은 비워둬도 동작)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=onstori-media
R2_BUCKET_PRIVATE=onstori-private
R2_PUBLIC_BASE=https://img.onstori.com

# 문의 접수 (docs/specs/inquiry.md) — 알림 채널은 env 가 없으면 건너뛴다
INQUIRY_SALT=
RESEND_API_KEY=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# ── 2026-09-05 이야기 엔진 · 온보딩 · 정회원 (기획1 /mainplan) ──
# 온보딩 1단계 "네이버 플레이스에서 불러오기" — 네이버 개발자센터 검색 API. 없으면 버튼이 숨는다(카카오 REST 키만 있어도 동작)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 60초 녹화 링크 서명 비밀 — 없으면 INQUIRY_SALT → ADMIN_KEY 순으로 대신 쓴다
STORY_LINK_SECRET=
# Vercel Cron(/api/cron/expire, 매일 03:00 KST) 인증 — Vercel 프로젝트 env 에 같은 값
CRON_SECRET=

# ── 2026-09-18 녹화 화질 (지시 [51]) ──
# 캔버스 중계 끄기(예전 방식으로 되돌리기) — off/false/0 이면 꺼진다. 비어 있으면 «켜짐»
NEXT_PUBLIC_RECORDING_CANVAS_RELAY=
# 영상 초당 비트 — 비어 있으면 6000000(지금 값). 0.3M~20M 밖이면 조용히 기본값으로 돌아간다
#   6000000 → 60초 약 42.7MB · 3000000 → 약 23MB · 1500000 → 약 12MB · 1000000 → 약 8.5MB
#   ⚠ 「상한」이 아니라 「부탁」이다 — 기기가 더 쓰기도 한다(안드로이드 +37% 실측)
NEXT_PUBLIC_RECORDING_VIDEO_BPS=
