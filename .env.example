# 복사해서 .env.local 로 사용 (.env.local 은 git에 올라가지 않음)
# 값은 Supabase 대시보드 → Settings → API 에서 복사

NEXT_PUBLIC_SUPABASE_URL=https://wpsrfjqfbhmeriscdacu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# P2에서 사용
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# P4 카카오 로그인 (카카오 개발자 콘솔 → 앱 키 / 보안)
# Supabase 카카오 프로바이더 대신 OIDC 직결 — 자세한 이유는 lib/kakao.ts
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# P5에서 사용 (토스페이먼츠 — 통신판매업 신고 후)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 이미지 저장소 — Cloudflare R2 (docs/specs/storage-r2.md)
# 6개가 전부 있어야 R2를 쓰고, 하나라도 비면 Supabase Storage로 폴백한다(로컬은 비워둬도 동작)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=onstori-media
R2_BUCKET_PRIVATE=onstori-private
R2_PUBLIC_BASE=https://img.onstori.com
